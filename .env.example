# Copy this file to .env and fill in your own keys.
# NEVER commit the real .env file — it is already in .gitignore.

# --- LLM / explanation engine (Module 4) ---
GEMINI_API_KEY=
# Model name. Google retires models regularly (gemini-1.5-flash is gone); change here, not in code.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Math solver fallback (Module 3C) --- OPTIONAL
# Only used when SymPy cannot solve something. Leave empty to skip it.
# Free (non-commercial, ~2000 calls/month): developer.wolframalpha.com -> Get an AppID
# -> choose "Full Results API".
WOLFRAMALPHA_APP_ID=

# --- Voice engine (Module 5) --- OPTIONAL
# The default voice is gTTS (free, no key). ElevenLabs only gives a more natural voice:
# free plan = 10,000 credits/month, non-commercial, attribution required. Leave empty to skip.
ELEVENLABS_API_KEY=
# (Speech-to-text uses the local Whisper model, so no OpenAI key is needed.)

# --- Model hosting (HuggingFace Hub, for fine-tuned TrOCR weights) ---
HUGGINGFACE_TOKEN=

# --- OCR thresholds ---
OCR_CONFIDENCE_THRESHOLD=0.60
OCR_LOW_CONFIDENCE_THRESHOLD=0.35
TROCR_BASE_MODEL=microsoft/trocr-large-handwritten
PIX2TEX_MODEL=lukas-blecher/LaTeX-OCR

# --- Image quality thresholds ---
BLUR_VARIANCE_THRESHOLD=30.0
MIN_BRIGHTNESS=40.0
MAX_BRIGHTNESS=235.0
TARGET_IMAGE_SIZE=1024

# --- Solver behaviour ---
WOLFRAMALPHA_MONTHLY_QUOTA=2000
SOLVER_TIMEOUT_SECONDS=10
ENABLE_WOLFRAM_FALLBACK=true
ENABLE_GEMINI_EXPLANATIONS=true

# --- Voice defaults ---
DEFAULT_VOICE_LANGUAGE=hi-en
DEFAULT_VOICE_SPEED=1.0

# --- Networking ---
API_MAX_RETRIES=3
API_BACKOFF_SECONDS=1.5

# --- Logging ---
LOG_LEVEL=INFO

# --- OCR speed (handwriting recognition) ---
# KV-cache decoding: ~2x fewer decoder passes. A self-check at warm-up falls back automatically.
OCR_KV_CACHE=true
# int8 dynamic quantization of the Linear layers (faster on CPU, accuracy NOT validated: benchmark first)
OCR_QUANTIZE=false
# CPU threads for inference (0 = all cores)
OCR_THREADS=0
# Load the OCR model at API / app start instead of on the first photo
PRELOAD_OCR=false
